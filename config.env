# 企业微信机器人配置
# 支持多个机器人，通过注解 wechatRobot 指定或 URL 参数 ?key= 指定

# 默认机器人 Webhook Key（必填，作为 fallback）
ROBOT_KEY_DEFAULT=6976d6f8-88db-4ee1-98eb-e238f581e378

# 服务监听地址
ADDR=:8999

# Grafana 面板链接（用于告警消息中的链接）
# 格式：域名:端口，不含 http:// 前缀
GRAFANA_URL=172.16.11.236:3000

# Alertmanager 告警规则详情链接
# 格式：域名:端口，不含 http:// 前缀
ALERT_DOMAIN=172.16.11.236:9093

# ============ 多机器人配置 ============
# 在 Prometheus 告警规则的 annotations 中添加 wechatRobot: 机器人标识
# 系统会自动拼接为完整 URL：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<对应的key>
#
# 示例 PromQL 规则配置：
#   annotations:
#     summary: "CPU 使用率告警"
#     wechatRobot: critical  # <- 指定使用 critical 机器人的 key
#
# 然后在下面按名称定义对应的 key（名称需与告警规则中的 wechatRobot 注解值一致）
# ROBOT_KEY_critical=critical-robot-key-xxx
# ROBOT_KEY_warning=warning-robot-key-xxx
# ROBOT_KEY_info=info-robot-key-xxx